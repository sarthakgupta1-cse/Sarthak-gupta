# Nothing here is required to run discovery locally: all sources are public and keyless.
# Google Sheets, Gmail and Drive are reached through the Claude session's OAuth connectors,
# so no Google credentials or tokens are ever stored in this project.
#
# The scheduled task prompt supplies these (they are kept out of the public repo):
SHEET_ID=
SHEET_URL=
BACKUP_FOLDER_ID=
APPS_FOLDER_ID=
PROFILE_FOLDER_ID=
REPORT_RECIPIENT=
