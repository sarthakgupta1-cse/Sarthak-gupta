# Copy to .env for local runs. In GitHub Actions, set these as repository secrets.
# Variable NAMES only — never commit real values.

# --- Google Sheets (service account) ---
# Full JSON of the service-account key, on one line (or base64-encoded JSON).
GOOGLE_SERVICE_ACCOUNT_JSON=
# The ID from the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SPREADSHEET_ID=

# --- Email delivery: choose gmail_api (recommended) or smtp ---
EMAIL_TRANSPORT=gmail_api
# Gmail API OAuth (scope: gmail.send only)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# The Gmail address that sends the report (must be the account that authorised the token)
GMAIL_SENDER=
# SMTP fallback (Gmail App Password; requires 2-Step Verification)
SMTP_USERNAME=
SMTP_APP_PASSWORD=

# --- Report recipient ---
REPORT_RECIPIENT=

# --- LLM provider: anthropic | gemini | openai ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Search provider: brave | serper | none ---
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# --- Optional free sources ---
PRODUCT_HUNT_TOKEN=
