# ---------------------------------------------------------------------------
# Copy to .env and fill in what you have. Everything is OPTIONAL except where
# noted — the agent degrades gracefully and skips providers with no key.
# ---------------------------------------------------------------------------

# --- Discovery (free tier works with no key) -------------------------------
# GitHub: unauthenticated = 60 req/hr. A classic PAT with NO scopes = 5000/hr.
GITHUB_TOKEN=

# Product Hunt GraphQL v2 developer token: https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=

# --- LinkedIn (licensed API — we never scrape linkedin.com directly) -------
# Proxycurl: https://nubela.co/proxycurl  (~$0.01-0.03/profile)
PROXYCURL_API_KEY=
# Apollo.io: https://developer.apollo.io  (people search + enrich)
APOLLO_API_KEY=

# --- Email discovery + verification ---------------------------------------
# Hunter.io: https://hunter.io/api-keys
HUNTER_API_KEY=

# --- Output: Google Sheets -------------------------------------------------
# Path to a GCP service-account JSON key with the Sheets + Drive APIs enabled.
# Share the target spreadsheet with the service account's client_email.
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
# The spreadsheet ID from its URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=Leads

# --- Outreach identity (required by CAN-SPAM / GDPR if you email these leads)
OUTREACH_FROM_NAME=
OUTREACH_FROM_EMAIL=
OUTREACH_POSTAL_ADDRESS=
